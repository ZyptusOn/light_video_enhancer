<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LightVideoEnhancer_WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LightVideoEnhancer_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <NavigationView
        x:Name="MainNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="True"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="MainNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="ProcessNavItem" Content="处理" IsSelected="True" Tag="process">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Play" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="环境与后端" Tag="environment">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="模型与下载" Tag="models">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Download" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="关于" Tag="about">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Help" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid Padding="24,16,24,24">
            <ScrollViewer x:Name="ProcessView" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch">
                <StackPanel MaxWidth="1180" HorizontalAlignment="Center" Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="30" FontWeight="SemiBold" Text="视频增强" />
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Text="在独立处理进程中组合超分、插帧与硬件编码。界面关闭或取消时不会把 CUDA / Vulkan 运行时留在主进程。" />
                        </StackPanel>
                        <Border Grid.Column="1" Margin="20,4,0,0" Padding="10,5"
                                Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="12"
                                VerticalAlignment="Top">
                            <TextBlock x:Name="BackendBadgeText" FontWeight="SemiBold" Text="正在连接后端" />
                        </Border>
                    </Grid>

                    <InfoBar x:Name="BackendInfoBar" IsOpen="False" IsClosable="True"
                             Visibility="Collapsed" Closed="BackendInfoBar_Closed" />

                    <Border Style="{StaticResource CardStyle}" AllowDrop="True"
                            DragOver="InputCard_DragOver" Drop="InputCard_Drop">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="输入与输出" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="可将视频直接拖到此卡片。选择输入后会自动建议输出文件名。" />
                            </StackPanel>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InputPathBox" Header="输入视频" PlaceholderText="选择或拖入视频文件"
                                         TextChanged="InputPathBox_TextChanged" />
                                <Button Grid.Column="1" Margin="0,26,0,0" Click="BrowseInput_Click" Content="浏览…" />
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OutputPathBox" Header="输出文件" PlaceholderText="留空将自动生成" />
                                <Button Grid.Column="1" Margin="0,26,0,0" Click="BrowseOutput_Click" Content="另存为…" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="超分辨率" />
                                <ComboBox x:Name="SrEngineBox" Header="引擎" SelectedIndex="0"
                                          SelectionChanged="QualitySelection_Changed" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="自动选择（推荐）" Tag="auto" />
                                    <ComboBoxItem Content="D3D11 驱动 VSR" Tag="dxva_vsr" />
                                    <ComboBoxItem x:Name="NvVfxSrItem" Content="NVIDIA Video Effects VSR"
                                                  Tag="nvvfx" IsEnabled="False" />
                                    <ComboBoxItem Content="Real-CUGAN ncnn-vulkan" Tag="realcugan" />
                                    <ComboBoxItem Content="Real-ESRGAN ncnn-vulkan" Tag="realesrgan" />
                                    <ComboBoxItem Content="ESRGAN 经典模型 ncnn" Tag="esrgan" />
                                    <ComboBoxItem Content="Lanczos" Tag="lanczos" />
                                    <ComboBoxItem Content="双三次" Tag="bicubic" />
                                    <ComboBoxItem Content="不改变分辨率" Tag="none" />
                                </ComboBox>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="ScaleBox" Header="倍率" Value="2" Minimum="1" Maximum="4"
                                               SmallChange="0.25" SpinButtonPlacementMode="Compact" />
                                    <ComboBox x:Name="SrQualityBox" Grid.Column="1" Header="质量" SelectedIndex="2"
                                              ToolTipService.ToolTip="只影响支持质量档位的超分引擎。">
                                        <ComboBoxItem Content="极速" Tag="fast" />
                                        <ComboBoxItem Content="均衡" Tag="balanced" />
                                        <ComboBoxItem Content="质量" Tag="quality" />
                                        <ComboBoxItem Content="极致" Tag="ultra" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="插帧" />
                                <ComboBox x:Name="FiEngineBox" Header="引擎" SelectedIndex="0"
                                          SelectionChanged="QualitySelection_Changed" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="自动选择（推荐）" Tag="auto" />
                                    <ComboBoxItem x:Name="RifeFiItem" Content="RIFE AI（PyTorch）"
                                                  Tag="rife" IsEnabled="False" />
                                    <ComboBoxItem Content="RIFE ncnn-vulkan" Tag="rife_ncnn" />
                                    <ComboBoxItem Content="DIS 稠密光流" Tag="dis" />
                                    <ComboBoxItem Content="Farneback 光流" Tag="optical_flow" />
                                    <ComboBoxItem x:Name="TorchFlowFiItem" Content="CUDA 块匹配光流"
                                                  Tag="torch_flow" IsEnabled="False" />
                                    <ComboBoxItem Content="快速帧混合" Tag="blend" />
                                    <ComboBoxItem Content="不插帧" Tag="none" />
                                </ComboBox>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="FiMultiplierBox" Header="倍率" Value="2" Minimum="2" Maximum="4"
                                               SmallChange="1" SpinButtonPlacementMode="Compact" />
                                    <ComboBox x:Name="FiQualityBox" Grid.Column="1" Header="质量" SelectedIndex="2"
                                              ToolTipService.ToolTip="光流类引擎支持质量档位；RIFE 模型使用自身固定参数。">
                                        <ComboBoxItem Content="极速" Tag="fast" />
                                        <ComboBoxItem Content="均衡" Tag="balanced" />
                                        <ComboBoxItem Content="质量" Tag="quality" />
                                        <ComboBoxItem Content="极致" Tag="ultra" />
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="SrFirstCheck" Content="先超分再插帧（显存占用更高）" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="编码、设备与片段" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="自动编码器会根据显卡厂商选择可用硬件后端，并在同格式内依次回退。" />
                                </StackPanel>
                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CodecBox" Header="编码器" SelectedIndex="0"
                                              SelectionChanged="CodecBox_SelectionChanged">
                                        <ComboBoxItem Content="自动选择" Tag="auto" />
                                        <ComboBoxItem Content="H.264 NVIDIA" Tag="h264_nvenc" />
                                        <ComboBoxItem Content="H.264 AMD" Tag="h264_amf" />
                                        <ComboBoxItem Content="H.264 Media Foundation" Tag="h264_mf" />
                                        <ComboBoxItem Content="x264（CPU）" Tag="libx264" />
                                        <ComboBoxItem Content="HEVC / H.265 NVIDIA" Tag="hevc_nvenc" />
                                        <ComboBoxItem Content="HEVC / H.265 AMD" Tag="hevc_amf" />
                                        <ComboBoxItem Content="HEVC Media Foundation" Tag="hevc_mf" />
                                        <ComboBoxItem Content="x265（CPU）" Tag="libx265" />
                                        <ComboBoxItem Content="AV1 NVIDIA" Tag="av1_nvenc" />
                                        <ComboBoxItem Content="AV1 AMD" Tag="av1_amf" />
                                        <ComboBoxItem Content="SVT-AV1（CPU）" Tag="libsvtav1" />
                                        <ComboBoxItem Content="libaom AV1（CPU）" Tag="libaom-av1" />
                                        <ComboBoxItem Content="MPEG-4" Tag="mpeg4" />
                                    </ComboBox>
                                    <TextBox x:Name="PresetBox" Grid.Column="1" Header="Preset" Text="balanced" />
                                    <NumberBox x:Name="CrfBox" Grid.Column="2" Header="CQ / CRF" Value="23"
                                               Minimum="0" Maximum="63" SmallChange="1" SpinButtonPlacementMode="Compact" />
                                    <ComboBox x:Name="ContainerBox" Grid.Column="3" Header="容器" SelectedIndex="0">
                                        <ComboBoxItem Content="MP4" Tag="mp4" />
                                        <ComboBoxItem Content="MKV" Tag="mkv" />
                                        <ComboBoxItem Content="MOV" Tag="mov" />
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="NcnnGpuBox" Header="NCNN 设备" SelectedIndex="0">
                                        <ComboBoxItem Content="自动" Tag="auto" />
                                        <ComboBoxItem Content="CPU" Tag="cpu" />
                                    </ComboBox>
                                    <TextBox x:Name="StartTimeBox" Grid.Column="1" Header="开始（秒）" PlaceholderText="可选" />
                                    <TextBox x:Name="DurationBox" Grid.Column="2" Header="时长（秒）" PlaceholderText="可选" />
                                    <StackPanel Grid.Column="3" Padding="0,25,0,0" Spacing="5">
                                        <CheckBox x:Name="CopyAudioCheck" IsChecked="True" Content="复制源音频" />
                                        <CheckBox x:Name="OverwriteCheck" Content="覆盖已有输出" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TorchPythonBox" Header="外部 PyTorch / CUDA Python（可选）"
                                             PlaceholderText="自动检测，或指定 python.exe" />
                                    <Button Grid.Column="1" Margin="0,26,0,0" Click="BrowseTorchPython_Click" Content="选择…" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="任务" />
                                    <TextBlock x:Name="StatusText" Style="{StaticResource CaptionStyle}" Text="就绪" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="OpenOutputButton" Click="OpenOutput_Click" Content="打开输出位置" IsEnabled="False" />
                                    <Button x:Name="CancelButton" Click="Cancel_Click" Content="取消" IsEnabled="False" />
                                    <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}"
                                            Click="Start_Click" Content="开始处理" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar x:Name="TaskProgress" Minimum="0" Maximum="100" Value="0" />
                            <TextBox x:Name="LogBox" Height="230" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="EnvironmentView" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch">
                <StackPanel MaxWidth="1000" HorizontalAlignment="Center" Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="30" FontWeight="SemiBold" Text="环境与后端" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="快速检测不会导入 PyTorch；完整扫描只会在你手动触发时运行，并写入 24 小时缓存。" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="处理后端" />
                            <TextBlock x:Name="BackendPathText" TextWrapping="Wrap" FontFamily="Consolas" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="RefreshCapabilities_Click" Content="刷新快速检测" />
                                <Button x:Name="ScanEnvironmentsButton" Style="{StaticResource AccentButtonStyle}"
                                        Click="ScanEnvironments_Click" Content="扫描 Python / PyTorch 环境" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="硬件与可用能力" />
                            <TextBox x:Name="CapabilitiesBox" MinHeight="180" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" FontFamily="Consolas" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Python 环境" />
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Text="检测结果按 CUDA + NVIDIA VFX、CUDA、PyTorch 的可用性排序。可把合适的 python.exe 填入处理页。" />
                            <TextBox x:Name="EnvironmentResultsBox" MinHeight="240" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="NoWrap" FontFamily="Consolas"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ModelsView" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch">
                <StackPanel MaxWidth="1000" HorizontalAlignment="Center" Spacing="16">
        <StackPanel Spacing="4">
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="模型与下载" />
            <TextBlock Style="{StaticResource CaptionStyle}"
                       Text="轻量版可按需下载权重；全量版使用同一界面并将内置权重显示为已安装。模型保存在当前用户目录，程序升级不会覆盖。" />
        </StackPanel>
        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="下载源" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ModelSourceBox" Header="来源" SelectedIndex="0"
                              SelectionChanged="ModelSourceBox_SelectionChanged">
                        <ComboBoxItem Content="GitHub（官方）" Tag="github" />
                        <ComboBoxItem Content="GitHub Proxy（镜像）" Tag="mirror" />
                        <ComboBoxItem Content="自定义地址" Tag="custom" />
                    </ComboBox>
                    <TextBox x:Name="CustomSourceBox" Grid.Column="1" Header="自定义基础地址或 {archive} 模板"
                             IsEnabled="False" PlaceholderText="https://example.com/models" />
                    <Button Grid.Column="2" Margin="0,26,0,0" Click="RefreshModels_Click" Content="刷新状态" />
                </Grid>
                <TextBlock x:Name="ModelRootText" Style="{StaticResource CaptionStyle}" FontFamily="Consolas" />
            </StackPanel>
        </Border>
        <InfoBar x:Name="ModelInfoBar" IsOpen="False" IsClosable="True"
                 Visibility="Collapsed" Closed="ModelInfoBar_Closed" />
        <ProgressBar x:Name="ModelProgress" Minimum="0" Maximum="100" Value="0" />
        <TextBlock x:Name="ModelStatusText" Style="{StaticResource CaptionStyle}" Text="正在读取模型状态…" />
        <ListView x:Name="ModelPacksList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Description}" />
                            <TextBlock FontFamily="Consolas" Text="{Binding StatusText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="导入 ZIP" Tag="{Binding Id}" Click="ImportModel_Click" />
                            <Button Content="移除" Tag="{Binding Id}" Click="RemoveModel_Click"
                                    IsEnabled="{Binding CanRemove}" />
                            <Button Style="{StaticResource AccentButtonStyle}" Content="下载"
                                    Tag="{Binding Id}" Click="DownloadModel_Click"
                                    IsEnabled="{Binding CanDownload}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="AboutView" Visibility="Collapsed" HorizontalContentAlignment="Stretch">
                <StackPanel MaxWidth="760" HorizontalAlignment="Center" Spacing="16">
                    <TextBlock FontSize="30" FontWeight="SemiBold" Text="关于" />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Light Video Enhancer" />
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Text="WinUI 3 前端面向 Windows 10 1809 及以上系统；Windows 7 继续使用原有 Tk 前端。两个界面共享相同的 Python、C/C++、NCNN、CUDA 与 FFmpeg 处理核心。" />
                            <TextBlock x:Name="VersionText" Text="版本 0.5.2 · WinUI 3" />
                            <HyperlinkButton NavigateUri="https://github.com/ZyptusOn/light_video_enhancer"
                                             Content="打开 GitHub 仓库" />
                            <ComboBox x:Name="ThemeBox" Header="界面主题" SelectedIndex="0"
                                      SelectionChanged="ThemeBox_SelectionChanged" Width="220" HorizontalAlignment="Left">
                                <ComboBoxItem Content="跟随系统" Tag="system" />
                                <ComboBoxItem Content="浅色" Tag="light" />
                                <ComboBoxItem Content="深色" Tag="dark" />
                            </ComboBox>
                            <ComboBox x:Name="LanguageBox" Header="界面语言" SelectedIndex="0"
                                      SelectionChanged="LanguageBox_SelectionChanged" Width="220" HorizontalAlignment="Left">
                                <ComboBoxItem Content="跟随系统" Tag="system" />
                                <ComboBoxItem Content="中文" Tag="zh-CN" />
                                <ComboBoxItem Content="英文" Tag="en-US" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Page>
